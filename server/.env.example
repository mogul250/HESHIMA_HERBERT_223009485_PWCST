# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/restaurant-order-system

# JWT Authentication Secret
JWT_SECRET=restroflow-jwt-secret-key-2026

